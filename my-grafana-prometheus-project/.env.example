# Copy this file to .env and fill in the values. Do NOT commit your real token.
# Dynatrace connection for the OneAgent container
# SaaS example: https://<environment-id>.live.dynatrace.com/api
# Managed/ActiveGate: https://<host>[:port]/e/<environment-id>/api
DT_API_URL=https://<your-env-or-activegate>/e/<env-id>/api
DT_API_TOKEN=dt0c01...<installer-download-token>

# Optional: route via a Dynatrace Network Zone
# DT_NETWORK_ZONE=dev-zone

# Optional: free-form tags for processes/services
# DT_TAGS=owner=you,env=local

# Optional: corporate proxy settings if required for outbound HTTPS
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1
